# Copy this file to ".env" and fill in real values. Never upload .env to GitHub.

# PostgreSQL connection link. Remote databases must use verified TLS:
# sslmode=verify-full. Without DATABASE_CA_CERT, the app rejects remote URLs
# that disable TLS or skip certificate/hostname verification (for example
# no-verify, disable, prefer, require, or verify-ca). When DATABASE_CA_CERT
# is set, the app ignores the URL's SSL-mode parameters and verifies against
# that CA instead; still set verify-full in new connection strings.
#  - Supabase: use the "Transaction pooler" string with sslmode=verify-full,
#    then configure its root certificate as described for DATABASE_CA_CERT.
#  - Another remote PostgreSQL with a publicly trusted certificate: use
#    sslmode=verify-full and omit sslrootcert so Node's trust store is used.
#  - Local:    postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# CA certificate used to verify a remote PostgreSQL server whose certificate
# is not signed by a public root in Node's trust store. For Supabase, download
# the root certificate from Database settings -> SSL Configuration. On
# Vercel, paste the complete PEM contents (including BEGIN/END CERTIFICATE)
# into this variable. For a local file instead, leave this blank and append
# &sslrootcert=/absolute/path/to/prod-ca-2021.crt to DATABASE_URL. Never use
# an unverified TLS mode as a substitute for configuring this certificate.
DATABASE_CA_CERT=

# Administrator sign-in is database-backed at /admin/sign-in. There is no
# shared administrator password environment variable. The first owner is
# created only through the restricted one-time setup flow documented in
# docs/ADMIN_IDENTITY.md; later administrators are invited individually.

# Secret used to sign login cookies. Required. Generate a fresh value with:
# openssl rand -hex 32
# Do not use a human passphrase or copy this placeholder; weak values fail startup.
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Secret used to sign database-backed administrator account session cookies.
# Required. Generate another fresh value with `openssl rand -hex 32`; it MUST
# differ from SESSION_SECRET. Missing, weak, placeholder, or shared values
# fail startup and make administrator sign-in return HTTP 503.
ADMIN_SESSION_SECRET=replace-with-different-openssl-rand-hex-32-output

# Optional but recommended server-only key for encrypting individual
# administrator TOTP secrets and hashing recovery codes. Generate a separate
# `openssl rand -hex 32` value; it must differ from SESSION_SECRET and
# ADMIN_SESSION_SECRET. If blank, the application derives a domain-separated
# key from ADMIN_SESSION_SECRET. Once administrators enroll, changing/removing
# this value makes existing authenticator/recovery verification unavailable
# until the original key is restored, so back it up as production key material.
ADMIN_MFA_ENCRYPTION_SECRET=

# Optional credential for automated access to detailed /api/health diagnostics.
# Leave blank to allow detailed output only with a signed-in admin session.
# If set, generate a separate value with `openssl rand -hex 32`; weak or reused
# values fail startup. Send it only as `Authorization: Bearer <token>` over
# HTTPS—never in a URL query string, browser code, or NEXT_PUBLIC_* variable.
HEALTH_DIAGNOSTIC_TOKEN=

# Transactional email for signup verification, password recovery, account
# email changes and security notices. Both are required; without them, signup
# and email-based recovery return HTTP 503 rather than creating an unsafe fallback.
# Verify the sending domain in Resend before using an @theyaar.com sender.
RESEND_API_KEY=re_change-me
EMAIL_FROM=YaarLink <no-reply@theyaar.com>

# Optional public origin used in verification links. If unset, the request origin is used.
APP_URL=https://www.theyaar.com

# Optional separate secret for signing the short-lived public-form security
# challenges. If blank, SESSION_SECRET is used. If set, generate it with
# `openssl rand -hex 32` and make it different from both session secrets;
# weak or shared values fail startup.
BOT_CHALLENGE_SECRET=

# Optional compatible Have I Been Pwned range endpoint for a mirror or tests.
# The default is https://api.pwnedpasswords.com/range. Password creation and
# changes send only the first five characters of the password's SHA-1 hash.
PWNED_PASSWORDS_RANGE_URL=

# Optional slow-query warning threshold in milliseconds. If unset or invalid,
# 1000 is used; valid values are clamped to 50–60000. Slow-query logs contain
# only duration, SQL operation, row count/outcome, and a hashed normalized
# query fingerprint—never SQL text or bound parameters.
SLOW_QUERY_THRESHOLD_MS=1000

# Deployment/client-IP trust: Vercel is the only supported production host.
# Vercel sets VERCEL=1 itself, and only then does the rate limiter trust
# Vercel's client-IP headers. There is no proxy-trust variable to configure;
# in local development requests deliberately share the conservative
# "unknown" rate-limit bucket.

# Public browser configuration: this application needs no project-defined
# NEXT_PUBLIC_* variables. Never copy a database URL/password, service-role
# key, JWT/signing secret, API secret, or token into a NEXT_PUBLIC_* name.
# next.config.ts checks public variable names (never their values) and fails
# the build for unapproved or secret-like names.
