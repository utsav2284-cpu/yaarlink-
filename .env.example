# Copy this file to ".env" and fill in real values. Never upload .env to GitHub.

# PostgreSQL connection link.
#  - Neon:     copy the "Pooled connection" string; it already ends with ?sslmode=require
#  - Supabase: use the "Transaction pooler" string and put ?sslmode=no-verify at the end
#  - Local:    postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Password for the owner-only /admin page (budgets, phone numbers, messages).
# Use something long that only you know. Required.
ADMIN_PASSWORD=change-me-to-a-long-secret

# Secret used to sign login cookies. Required. Any long random text, e.g. from: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-random-characters

# Secret used to sign the admin session cookie. Required, and MUST be different from
# SESSION_SECRET; the app refuses admin login/logout (HTTP 503) if it is missing or equal.
ADMIN_SESSION_SECRET=change-me-to-another-64-random-characters

# Optional authenticator-app MFA for /admin. Leave blank to use password-only login.
# To enable it, enroll a Base32 TOTP secret (at least 16 Base32 characters) in your
# authenticator app and set the same secret here. An invalid/short value fails closed.
ADMIN_TOTP_SECRET=

# Transactional email for signup verification, password recovery, account
# email changes and security notices. Both are required; without them, signup
# and email-based recovery return HTTP 503 rather than creating an unsafe fallback.
# Verify the sending domain in Resend before using an @theyaar.com sender.
RESEND_API_KEY=re_change-me
EMAIL_FROM=YaarLink <no-reply@theyaar.com>

# Optional public origin used in verification links. If unset, the request origin is used.
APP_URL=https://www.theyaar.com

# Optional separate secret for signing the short-lived public-form security
# challenges. If blank, SESSION_SECRET is used. Prefer a different long random value.
BOT_CHALLENGE_SECRET=

# Client-IP headers are trusted automatically only on Cloudflare Workers, Vercel
# and Netlify. For another deployment, leave these blank unless that proxy is the
# only ingress, strips client-supplied forwarding headers, and the origin cannot
# be reached directly. Never enable them for a directly exposed origin.
# TRUST_CLOUDFLARE_HEADERS=true trusts cf-connecting-ip.
# TRUST_PROXY_HEADERS=true trusts x-forwarded-for; TRUST_PROXY_HOPS is the number
# of trusted proxies appended to that chain (default 1).
TRUST_CLOUDFLARE_HEADERS=
TRUST_PROXY_HEADERS=
TRUST_PROXY_HOPS=1
