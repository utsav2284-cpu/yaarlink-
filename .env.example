# Copy to .env and provide real values. Never commit .env or share secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
# Complete CA PEM only when the PostgreSQL server needs a private trust root.
DATABASE_CA_CERT=

# Required user-session signing key: openssl rand -hex 32
SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Optional separate key for public-form challenges. Blank uses SESSION_SECRET.
BOT_CHALLENGE_SECRET=

# Optional bearer credential for detailed /api/health diagnostics.
HEALTH_DIAGNOSTIC_TOKEN=

# Email used for signup verification and account recovery.
RESEND_API_KEY=re_change-me
EMAIL_FROM=YaarLink <no-reply@theyaar.com>
APP_URL=https://www.theyaar.com

# Optional compatible Have I Been Pwned range endpoint.
PWNED_PASSWORDS_RANGE_URL=
# Optional slow-query warning threshold, milliseconds (default 1000).
SLOW_QUERY_THRESHOLD_MS=1000
NEXT_PUBLIC_SUPABASE_URL=https://qwngmsedyepghskoagaj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
