# Local offline development only. Copy to .env.local; never use locally
# generated credentials or service endpoints in Production.
DATABASE_URL=postgresql://yaarlink_app:yaarlink_local_app@127.0.0.1:5432/yaarlink_local
BOOTSTRAP_DATABASE_URL=postgresql://postgres:yaarlink_local_admin@127.0.0.1:5432/yaarlink_local
DATABASE_CA_CERT=

# Generate a local signing key with: openssl rand -hex 32
SESSION_SECRET=replace-with-local-openssl-rand-32
BOT_CHALLENGE_SECRET=
HEALTH_DIAGNOSTIC_TOKEN=

# Local stubs from `npm run local:services`.
RESEND_API_KEY=local-dev-only
RESEND_API_BASE_URL=http://127.0.0.1:4025
EMAIL_FROM=YaarLink Local <no-reply@theyaar.com>
PWNED_PASSWORDS_RANGE_URL=http://127.0.0.1:4025/range
APP_URL=http://127.0.0.1:3000
SLOW_QUERY_THRESHOLD_MS=1000
