# Local offline development only. Copy to .env.local, then replace every
# generated-secret placeholder. Never use these local DB credentials or local
# service endpoints in Vercel/production.

DATABASE_URL=postgresql://yaarlink_app:yaarlink_local_app@127.0.0.1:5432/yaarlink_local
BOOTSTRAP_DATABASE_URL=postgresql://postgres:yaarlink_local_admin@127.0.0.1:5432/yaarlink_local
DATABASE_CA_CERT=

# Generate each signing secret separately: openssl rand -hex 32
SESSION_SECRET=replace-with-local-openssl-rand-hex-32-output
ADMIN_SESSION_SECRET=replace-with-a-different-local-openssl-output
BOT_CHALLENGE_SECRET=

# Administrator sign-in is database-backed at /admin/sign-in. There is no
# shared local administrator password environment variable; create the local
# first owner only through the restricted setup flow in docs/ADMIN_IDENTITY.md.
# Optional local-only key for individual administrator MFA. Generate separately
# with `openssl rand -hex 32`, or leave blank to derive from the local
# ADMIN_SESSION_SECRET. Never copy the production value into a local checkout.
ADMIN_MFA_ENCRYPTION_SECRET=
HEALTH_DIAGNOSTIC_TOKEN=

# LOCAL EMBEDDED-PREVIEW ONLY. The administrator session cookie is
# SameSite=Strict by default; browsers refuse to store/send Strict cookies
# inside a cross-site preview iframe, which makes a correct admin login
# bounce back to sign-in. Setting this to `none` switches the local cookie
# to SameSite=None + Secure + Partitioned (CHIPS) ONLY when APP_URL is a
# loopback URL as below — the override is ignored for any non-loopback
# APP_URL. Never set this in production; production keeps Strict.
#ADMIN_COOKIE_SAME_SITE=none

# Local stubs from `npm run local:services`. The email stub writes test
# messages to .local/email-outbox.jsonl; the range stub is not a real breach
# database and exists only so password flows can be exercised offline.
RESEND_API_KEY=local-dev-only
RESEND_API_BASE_URL=http://127.0.0.1:4025
EMAIL_FROM=YaarLink Local <no-reply@theyaar.com>
PWNED_PASSWORDS_RANGE_URL=http://127.0.0.1:4025/range

APP_URL=http://127.0.0.1:3000
SLOW_QUERY_THRESHOLD_MS=1000
