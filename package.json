{
  "name": "nextjs-postgresql-template",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:health": "node --experimental-strip-types --test tests/health-diagnostics.test.mjs",
    "db:check": "drizzle-kit check --config=drizzle.config.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.json",
    "db:bootstrap": "node scripts/database-bootstrap.mjs",
    "db:bootstrap:verify": "node scripts/database-bootstrap.mjs --verify-write",
    "local:db:up": "docker compose up -d db",
    "local:db:down": "docker compose down",
    "local:db:logs": "docker compose logs -f db",
    "local:services": "node scripts/local-dev-services.mjs",
    "local:bootstrap": "node --env-file=.env.local scripts/database-bootstrap.mjs --verify-write"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "postcss": "8.5.32"
  }
}
